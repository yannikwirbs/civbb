{
  "permissions": {
    "deny": ["Artifact", "PowerShell", "ReportFindings", "ListAgents", "ScheduleWakeup"]
  },
  "enabledPlugins": {
    "unity@claude-plugins-official": false
  },
  "statusLine": {
    "type": "command",
    "command": "python \"$CLAUDE_PROJECT_DIR/tools/context.py\" statusline"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Agent|WebFetch|LSP",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/context.py\" hook" }]
      }
    ]
  }
}
