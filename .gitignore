/target
# Third-party avatars used for local testing only; never commit (design doc §21, licences).
/corpus/local/
# Generated outputs of local runs
/out/
*.civpkg
# Unity's generated state for tools/unity-truth; only the scripts, manifest and editor version are source.
/tools/unity-truth/*/
!/tools/unity-truth/Assets/
!/tools/unity-truth/Packages/
!/tools/unity-truth/ProjectSettings/
/tools/unity-truth/*.csproj
/tools/unity-truth/*.sln*
/tools/unity-truth/Packages/packages-lock.json
/tools/unity-truth/ProjectSettings/*
!/tools/unity-truth/ProjectSettings/ProjectVersion.txt
