{
  "source": "Hand-derived from ADR 0010: a 1 s cross-fade from a state animating A.x = 1 to one animating B.x = 1. WD on: properties the other state lacks blend with their default 0.",
  "nodes": [{ "name": "A" }, { "name": "B" }],
  "params": [{ "name": "p", "kind": "Bool", "default": 0 }],
  "clips": {
    "A1": { "length": 1, "curves": [["A.x", [[0, 1]]]] },
    "B1": { "length": 1, "curves": [["B.x", [[0, 1]]]] }
  },
  "layers": [{
    "name": "L",
    "states": [
      { "name": "S1", "motion": { "clip": "A1" }, "wd": true, "transitions": [{ "to": "S2", "if": ["p"], "duration": 1 }] },
      { "name": "S2", "motion": { "clip": "B1" }, "wd": true }
    ]
  }],
  "dt": 0.5,
  "frames": [
    { "expect": { "A.x": 1, "B.x": 0 } },
    { "set": { "p": 1 }, "expect": { "L": "S1", "A.x": 1, "B.x": 0 } },
    { "expect": { "A.x": 0.5, "B.x": 0.5 } },
    { "expect": { "L": "S2", "A.x": 0, "B.x": 1 } }
  ]
}
