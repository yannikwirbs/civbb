{
  "$defs": {
    "Action": {
      "description": "What a state does on enter (ADR 0085).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Changes state entries.",
          "properties": {
            "ops": {
              "description": "Operations, in order.",
              "items": {
                "$ref": "#/$defs/EntryOp"
              },
              "type": "array"
            },
            "owner_only": {
              "description": "Run only for the avatar's owner.",
              "type": "boolean"
            },
            "type": {
              "const": "entries",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner_only",
            "ops"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Sets where body parts take their pose from.",
          "properties": {
            "parts": {
              "description": "Each part and its new source.",
              "items": {
                "$ref": "#/$defs/PartSource"
              },
              "type": "array"
            },
            "type": {
              "const": "pose_source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "parts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blends a layer's weight.",
          "properties": {
            "duration": {
              "description": "Blend time in seconds.",
              "format": "float",
              "type": "number"
            },
            "goal": {
              "description": "Goal weight.",
              "format": "float",
              "type": "number"
            },
            "layer": {
              "description": "Target layer.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "layer_weight",
              "type": "string"
            }
          },
          "required": [
            "type",
            "layer",
            "goal",
            "duration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blends a layer group's weight.",
          "properties": {
            "duration": {
              "description": "Blend time in seconds.",
              "format": "float",
              "type": "number"
            },
            "goal": {
              "description": "Goal weight.",
              "format": "float",
              "type": "number"
            },
            "group": {
              "description": "Target group.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "group_weight",
              "type": "string"
            }
          },
          "required": [
            "type",
            "group",
            "goal",
            "duration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enables or disables locomotion.",
          "properties": {
            "disabled": {
              "description": "Locomotion disabled while true.",
              "type": "boolean"
            },
            "type": {
              "const": "locomotion",
              "type": "string"
            }
          },
          "required": [
            "type",
            "disabled"
          ],
          "type": "object"
        }
      ]
    },
    "Animator": {
      "additionalProperties": false,
      "description": "An animator: one layer list in evaluation order, each layer tagged with its [`LayerGroup`].",
      "properties": {
        "groups": {
          "description": "Layer groups, each weighted as a whole.",
          "items": {
            "$ref": "#/$defs/LayerGroup"
          },
          "type": "array"
        },
        "layers": {
          "description": "Layers, evaluated in order.",
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        }
      },
      "required": [
        "groups",
        "layers"
      ],
      "type": "object"
    },
    "BlendTreeKind": {
      "description": "Blend algorithms.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "param": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "simple_1d",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "simple_directional_2d",
              "type": "string"
            },
            "x": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "freeform_directional_2d",
              "type": "string"
            },
            "x": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "freeform_cartesian_2d",
              "type": "string"
            },
            "x": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "BodyPart": {
      "description": "Humanoid body parts of a layer mask.",
      "enum": [
        "root",
        "body",
        "head",
        "left_leg",
        "right_leg",
        "left_arm",
        "right_arm",
        "left_fingers",
        "right_fingers",
        "left_foot_ik",
        "right_foot_ik",
        "left_hand_ik",
        "right_hand_ik"
      ],
      "type": "string"
    },
    "ChildMotion": {
      "additionalProperties": false,
      "description": "A child of a blend tree.",
      "properties": {
        "cycle_offset": {
          "description": "Normalised time offset.",
          "format": "float",
          "type": "number"
        },
        "direct_param": {
          "description": "Weight parameter for `Direct` trees.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mirror": {
          "default": false,
          "description": "Mirrors the child's humanoid muscles; combines with its state's and parents' mirrors by exclusive or.",
          "type": "boolean"
        },
        "motion": {
          "$ref": "#/$defs/Motion",
          "description": "The child's motion."
        },
        "position": {
          "description": "2D position.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "threshold": {
          "description": "1D threshold.",
          "format": "float",
          "type": "number"
        },
        "time_scale": {
          "description": "Speed multiplier.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "motion",
        "threshold",
        "position",
        "time_scale",
        "cycle_offset"
      ],
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "description": "An animation clip.",
      "properties": {
        "curves": {
          "description": "Animated properties.",
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "type": "array"
        },
        "length": {
          "description": "Length in seconds.",
          "format": "float",
          "type": "number"
        },
        "looping": {
          "description": "Loop time.",
          "type": "boolean"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/RootSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the body pose curves (`HumanoidProperty::Body`) reach the pose; `None` takes them as keyed (ADR 0063)."
        }
      },
      "required": [
        "name",
        "length",
        "looping",
        "curves"
      ],
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "One transition condition.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ConditionMode",
          "description": "Comparison."
        },
        "param": {
          "description": "Tested parameter.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "threshold": {
          "description": "Comparison value for numeric modes.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "param",
        "mode",
        "threshold"
      ],
      "type": "object"
    },
    "ConditionMode": {
      "description": "Condition comparisons.",
      "enum": [
        "if",
        "if_not",
        "greater",
        "less",
        "equals",
        "not_equal"
      ],
      "type": "string"
    },
    "ConstraintField": {
      "description": "What a clip can animate on a constraint (ADR 0040).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "[`Constraint::weight`].",
          "properties": {
            "type": {
              "const": "weight",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "[`Constraint::active`].",
          "properties": {
            "type": {
              "const": "active",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The weight of source `n`.",
          "properties": {
            "source": {
              "description": "Index into [`Constraint::sources`].",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "source_weight",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "[`ConstraintOptions::freeze`].",
          "properties": {
            "type": {
              "const": "freeze",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Curve": {
      "additionalProperties": false,
      "description": "One animated property.",
      "properties": {
        "keys": {
          "description": "Keys in ascending time.",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Target",
          "description": "What it animates."
        }
      },
      "required": [
        "target",
        "keys"
      ],
      "type": "object"
    },
    "EntryOp": {
      "description": "Operations on state entries.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "param": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "set",
              "type": "string"
            },
            "value": {
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "type",
            "param",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "param": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "add",
              "type": "string"
            },
            "value": {
              "format": "float",
              "type": "number"
            }
          },
          "required": [
            "type",
            "param",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Random in `[min, max]`; for bools, true with probability `chance`.",
          "properties": {
            "chance": {
              "format": "float",
              "type": "number"
            },
            "max": {
              "format": "float",
              "type": "number"
            },
            "min": {
              "format": "float",
              "type": "number"
            },
            "param": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "random",
              "type": "string"
            }
          },
          "required": [
            "type",
            "param",
            "min",
            "max",
            "chance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Copies `src` to `dst`, optionally remapping `from` range to `to` range.",
          "properties": {
            "dst": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "remap": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Remap"
                },
                {
                  "type": "null"
                }
              ]
            },
            "src": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "copy",
              "type": "string"
            }
          },
          "required": [
            "type",
            "src",
            "dst"
          ],
          "type": "object"
        }
      ]
    },
    "EulerOrder": {
      "description": "Orders of Euler rotations. One so far; others come with an importer whose source uses them.",
      "oneOf": [
        {
          "const": "zxy",
          "description": "About Z, then X, then Y (`q = qy qx qz`, ADR 0007).",
          "type": "string"
        }
      ]
    },
    "HumanBone": {
      "description": "Humanoid bones: VRM 1.0's humanoid bone set and names (ADR 0085 point 6), serialised as VRM writes them\n(`leftThumbMetacarpal`). Importers map other names (Unity's `HumanBodyBones`) by table.",
      "enum": [
        "hips",
        "spine",
        "chest",
        "upperChest",
        "neck",
        "head",
        "jaw",
        "leftEye",
        "rightEye",
        "leftShoulder",
        "leftUpperArm",
        "leftLowerArm",
        "leftHand",
        "rightShoulder",
        "rightUpperArm",
        "rightLowerArm",
        "rightHand",
        "leftUpperLeg",
        "leftLowerLeg",
        "leftFoot",
        "leftToes",
        "rightUpperLeg",
        "rightLowerLeg",
        "rightFoot",
        "rightToes",
        "leftThumbMetacarpal",
        "leftThumbProximal",
        "leftThumbDistal",
        "leftIndexProximal",
        "leftIndexIntermediate",
        "leftIndexDistal",
        "leftMiddleProximal",
        "leftMiddleIntermediate",
        "leftMiddleDistal",
        "leftRingProximal",
        "leftRingIntermediate",
        "leftRingDistal",
        "leftLittleProximal",
        "leftLittleIntermediate",
        "leftLittleDistal",
        "rightThumbMetacarpal",
        "rightThumbProximal",
        "rightThumbDistal",
        "rightIndexProximal",
        "rightIndexIntermediate",
        "rightIndexDistal",
        "rightMiddleProximal",
        "rightMiddleIntermediate",
        "rightMiddleDistal",
        "rightRingProximal",
        "rightRingIntermediate",
        "rightRingDistal",
        "rightLittleProximal",
        "rightLittleIntermediate",
        "rightLittleDistal"
      ],
      "type": "string"
    },
    "HumanoidProperty": {
      "description": "Animatable humanoid properties.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A muscle: the rotation of `bone` about one axis of its muscle frame, -1 to 1 over the muscle's range (ADR\n0014). The bones and axes that have muscles are listed in `civbb_anim::muscle::MUSCLES`.",
          "properties": {
            "axis": {
              "description": "Axis of the bone's muscle frame: 0 twist (X), 1 Y, 2 Z.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "bone": {
              "$ref": "#/$defs/HumanBone",
              "description": "The bone it turns."
            },
            "type": {
              "const": "muscle",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bone",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The body pose: position (0..3) or rotation (3..7) component (ADR 0063).",
          "properties": {
            "component": {
              "description": "Position (0..3) or rotation (3..7) component.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "body",
              "type": "string"
            }
          },
          "required": [
            "type",
            "component"
          ],
          "type": "object"
        }
      ]
    },
    "InterruptionSource": {
      "description": "Which transitions may interrupt a running transition.",
      "enum": [
        "none",
        "source",
        "destination",
        "source_then_destination",
        "destination_then_source"
      ],
      "type": "string"
    },
    "Key": {
      "additionalProperties": false,
      "description": "A Hermite key. Infinite tangents mean a constant (stepped) segment. JSON has no infinity\n(`serde_json` writes `null`), so a `null` tangent reads as +infinity (ADR 0041).",
      "properties": {
        "in_tangent": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "out_tangent": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "time": {
          "format": "float",
          "type": "number"
        },
        "value": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "time",
        "value"
      ],
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One animator layer.",
      "properties": {
        "blending": {
          "$ref": "#/$defs/LayerBlending",
          "description": "How the layer combines with the layers below."
        },
        "group": {
          "description": "Index into [`Animator::groups`].",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mask"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which bones and transforms the layer may write; `None` writes everything."
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "state_machine": {
          "$ref": "#/$defs/StateMachine",
          "description": "The layer's states."
        },
        "weight": {
          "description": "Initial weight, 0 to 1. A group's first layer always plays at weight 1.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "name",
        "group",
        "weight",
        "blending",
        "state_machine"
      ],
      "type": "object"
    },
    "LayerBlending": {
      "description": "Layer blending modes.",
      "enum": [
        "override",
        "additive"
      ],
      "type": "string"
    },
    "LayerGroup": {
      "additionalProperties": false,
      "description": "A group of layers with a shared weight.",
      "properties": {
        "name": {
          "description": "Name, e.g. `FX`.",
          "type": "string"
        },
        "weight": {
          "description": "Initial weight, 0 to 1.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "name",
        "weight"
      ],
      "type": "object"
    },
    "Mask": {
      "additionalProperties": false,
      "description": "A layer mask: humanoid body parts plus an optional node allowlist.",
      "properties": {
        "body_parts": {
          "description": "Enabled humanoid body parts.",
          "items": {
            "$ref": "#/$defs/BodyPart"
          },
          "type": "array"
        },
        "transforms": {
          "description": "Nodes the layer may animate (curves on their meshes and constraints too); `None` allows all.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "body_parts"
      ],
      "type": "object"
    },
    "MaterialField": {
      "description": "A material field curves can animate (ADR 0099), in the units the material stores it.",
      "oneOf": [
        {
          "const": "base_color",
          "description": "Base colour (PBR, Toon) or colour (Unlit), linear RGBA.",
          "type": "string"
        },
        {
          "const": "emission",
          "description": "Emission colour, linear RGB.",
          "type": "string"
        },
        {
          "const": "shade_color",
          "description": "Toon shade colour, linear RGB.",
          "type": "string"
        },
        {
          "const": "rim_color",
          "description": "Toon rim colour, linear RGB.",
          "type": "string"
        },
        {
          "const": "outline_color",
          "description": "Toon outline colour, linear RGB.",
          "type": "string"
        },
        {
          "const": "metallic",
          "description": "PBR metallic.",
          "type": "string"
        },
        {
          "const": "roughness",
          "description": "PBR roughness.",
          "type": "string"
        },
        {
          "const": "normal_scale",
          "description": "Normal map strength.",
          "type": "string"
        },
        {
          "const": "cutoff",
          "description": "Alpha cutoff of a masked material.",
          "type": "string"
        },
        {
          "const": "shade_shift",
          "description": "Toon shade shift.",
          "type": "string"
        },
        {
          "const": "shade_toony",
          "description": "Toon shade toony.",
          "type": "string"
        },
        {
          "const": "rim_power",
          "description": "Toon rim power.",
          "type": "string"
        },
        {
          "const": "matcap_strength",
          "description": "The first toon matcap's strength.",
          "type": "string"
        },
        {
          "const": "base_color_transform",
          "description": "The base colour texture's [`TextureSlot::scale_offset`].",
          "type": "string"
        },
        {
          "const": "light_min",
          "description": "Toon light clamp's lower bound.",
          "type": "string"
        },
        {
          "const": "light_max",
          "description": "Toon light clamp's upper bound.",
          "type": "string"
        }
      ]
    },
    "MeshProperty": {
      "description": "Animatable mesh instance properties.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Visible flag, 0 or 1.",
          "properties": {
            "type": {
              "const": "visible",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
