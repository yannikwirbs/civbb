        "bake_position_xz": {
          "description": "The body's horizontal position stays in the pose.",
          "type": "boolean"
        },
        "bake_position_y": {
          "description": "The body's height stays in the pose.",
          "type": "boolean"
        },
        "level": {
          "description": "Root height offset, in body position units.",
          "format": "float",
          "type": "number"
        },
        "loop_pose": {
          "description": "Loop pose: the baked part of the pose blends towards the clip's start over each cycle.",
          "type": "boolean"
        },
        "orientation_offset": {
          "description": "Root rotation offset, degrees about +Y in the format's coordinates.",
          "format": "float",
          "type": "number"
